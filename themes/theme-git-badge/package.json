{
  "name": "@show-docs/docusaurus-theme-git-badge",
  "version": "0.0.0",
  "description": "侧边栏里给「新建」与「更新过」的页面挂一枚颜色标记（叶子行一个点，分类行给折叠箭头染色）",
  "keywords": [],
  "homepage": "https://github.com/show-docs/docusaurus/tree/master/themes/theme-git-badge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/show-docs/docusaurus.git",
    "directory": "themes/theme-git-badge"
  },
  "bugs": {
    "url": "https://github.com/show-docs/docusaurus/issues"
  },
  "types": "dist/index.d.mts",
  "main": "dist/index.mjs",
  "exports": {
    ".": {
      "default": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "files": [
    "components",
    "dist",
    "styles",
    "theme"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@docusaurus/utils": "^3.9.2"
  },
  "peerDependencies": {
    "@docusaurus/core": "catalog:",
    "@docusaurus/types": "catalog:",
    "@show-docs/docusaurus-plugin-prev-layer-resolver": "workspace:^",
    "react": "catalog:"
  },
  "peerDependenciesMeta": {
    "@docusaurus/types": {
      "optional": true
    }
  },
  "engines": {
    "node": "^24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
