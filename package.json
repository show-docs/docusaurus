{
  "private": true,
  "name": "test-ci",
  "version": "0.0.1",
  "license": "UNLICENSED",
  "author": {
    "name": "Eric Chen"
  },
  "scripts": {
    "build": "pnpm build:core && docusaurus build",
    "build:core": "pnpm -r run build",
    "clear": "docusaurus clear",
    "docusaurus": "docusaurus",
    "fmt:prettier": "prettier -w .",
    "lint:eslint": "eslint . --fix --concurrency=auto --max-warnings=0",
    "lint:eslint:check": "eslint . --concurrency=auto --max-warnings=0",
    "lint:knip": "knip",
    "lint:knip:strict": "knip --strict",
    "lint:staged": "nice-move lint staged",
    "lint:type": "tsc -p tsconfig.json",
    "lint:version": "syncpack lint",
    "prepare": "nice-move git hooks",
    "serve": "docusaurus serve",
    "start": "pnpm build:core && docusaurus start",
    "swizzle": "docusaurus swizzle",
    "test": "pnpm build:core && vitest run",
    "test:coverage": "pnpm build:core && vitest run --coverage",
    "test:e2e": "pnpm build && bddgen && playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.tools.json tsconfig.test.json",
    "verify": "pnpm lint:type && pnpm typecheck && pnpm lint:eslint:check && pnpm lint:version && pnpm test:coverage && pnpm verify:chain && pnpm verify:context-deps",
    "verify:chain": "pnpm build && node tools/scripts/verify-chain.mts",
    "verify:context-deps": "pnpm build && node tools/scripts/verify-context-deps.mts",
    "version:bump": "pnpm version -r patch --no-git-checks --filter=!. --filter=!./tools/*",
    "version:pin": "syncpack fix"
  },
  "dependencies": {
    "@docusaurus/core": "catalog:",
    "@docusaurus/plugin-content-docs": "^3.9.2",
    "@docusaurus/preset-classic": "^3.9.2",
    "@docusaurus/theme-common": "catalog:",
    "@show-docs/docusaurus-plugin-compile-source": "workspace:^",
    "@show-docs/docusaurus-plugin-lazy-compilation": "workspace:^",
    "@show-docs/docusaurus-plugin-prev-layer-resolver": "workspace:^",
    "@show-docs/docusaurus-theme-avatar": "workspace:^",
    "@show-docs/docusaurus-theme-component-page": "workspace:^",
    "@show-docs/docusaurus-theme-copy-button": "workspace:^",
    "@show-docs/docusaurus-theme-diff": "workspace:^",
    "@show-docs/docusaurus-theme-erd": "workspace:^",
    "@show-docs/docusaurus-theme-git-badge": "workspace:^",
    "@show-docs/docusaurus-theme-iframe": "workspace:^",
    "@show-docs/docusaurus-theme-markmap": "workspace:^",
    "@show-docs/docusaurus-theme-redoc": "workspace:^",
    "@show-docs/docusaurus-theme-scalar": "workspace:^",
    "@show-docs/docusaurus-theme-stoplight": "workspace:^",
    "@show-docs/docusaurus-theme-viewer": "workspace:^",
    "@show-docs/docusaurus-theme-word-count": "workspace:^",
    "@show-docs/theme-a": "workspace:^",
    "@show-docs/theme-b": "workspace:^",
    "@show-docs/theme-base": "workspace:^",
    "@show-docs/theme-c": "workspace:^",
    "react": "catalog:",
    "react-dom": "~18.3.1"
  },
  "devDependencies": {
    "@bring-it/cli": "^0.11.3",
    "@bring-it/npm": "^0.9.6",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/types": "catalog:",
    "@docusaurus/utils": "catalog:",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@mdx-js/react": "^3.1.1",
    "@nice-move/all-in-react": "^0.9.6",
    "@nice-move/syncpack-config": "^0.6.2",
    "@playwright/test": "~1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "@vitest/coverage-istanbul": "^5.1.0",
    "enhanced-resolve": "^5.26.1",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.17.1",
    "garou": "^0.9.22",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "playwright-bdd": "~9.2.1",
    "prettier": "~3.9.10",
    "syncpack": "^15.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "webpack": "catalog:"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^24.0.0 || ^26.0.0",
    "pnpm": "^12.15.0"
  },
  "browserslist": {
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 3 safari version"
    ],
    "production": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "prettier": "@nice-move/all-in-react/prettier"
}
