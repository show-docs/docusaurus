{
  "private": true,
  "name": "test-ci",
  "version": "0.0.1",
  "license": "UNLICENSED",
  "author": {
    "name": "Eric Chen"
  },
  "scripts": {
    "build": "pnpm build:core && docusaurus build",
    "build:core": "pnpm --filter=@show-docs/docusaurus-plugin-prev-layer-resolver --filter=@show-docs/docusaurus-theme-copy-button --filter=@show-docs/docusaurus-theme-diff --filter=@show-docs/docusaurus-theme-erd --filter=@show-docs/docusaurus-theme-markmap --filter=@show-docs/docusaurus-theme-iframe --filter=@show-docs/docusaurus-theme-stoplight --filter=@show-docs/docusaurus-theme-redoc --filter=@show-docs/docusaurus-theme-scalar --filter=@show-docs/docusaurus-theme-viewer run build",
    "clear": "docusaurus clear",
    "docusaurus": "docusaurus",
    "fmt:prettier": "prettier -w .",
    "lint:eslint": "eslint . --fix --concurrency=auto",
    "lint:staged": "nice-move lint staged",
    "lint:type": "tsc -p tsconfig.json",
    "lint:version": "syncpack lint",
    "prepare": "nice-move git hooks",
    "serve": "docusaurus serve",
    "start": "pnpm build:core && docusaurus start",
    "swizzle": "docusaurus swizzle",
    "test": "pnpm build:core && vitest run",
    "test:coverage": "pnpm build:core && vitest run --coverage",
    "test:e2e": "pnpm build && bddgen && playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.demo.json tsconfig.test.json",
    "verify": "pnpm lint:type && pnpm lint:eslint && pnpm lint:version && pnpm test:coverage && pnpm verify:chain",
    "verify:chain": "pnpm build && node demo/scripts/verify-chain.mts",
    "version:pin": "syncpack fix"
  },
  "dependencies": {
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/preset-classic": "^3.9.2",
    "@show-docs/docusaurus-plugin-prev-layer-resolver": "workspace:^",
    "@show-docs/docusaurus-theme-copy-button": "workspace:^",
    "@show-docs/docusaurus-theme-diff": "workspace:^",
    "@show-docs/docusaurus-theme-erd": "workspace:^",
    "@show-docs/docusaurus-theme-iframe": "workspace:^",
    "@show-docs/docusaurus-theme-markmap": "workspace:^",
    "@show-docs/docusaurus-theme-redoc": "workspace:^",
    "@show-docs/docusaurus-theme-scalar": "workspace:^",
    "@show-docs/docusaurus-theme-stoplight": "workspace:^",
    "@show-docs/docusaurus-theme-viewer": "workspace:^",
    "@show-docs/theme-a": "workspace:^",
    "@show-docs/theme-b": "workspace:^",
    "@show-docs/theme-c": "workspace:^",
    "react": "~18.3.1",
    "react-dom": "~18.3.1"
  },
  "devDependencies": {
    "@bring-it/cli": "^0.11.3",
    "@bring-it/npm": "^0.9.6",
    "@docusaurus/types": "^3.9.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@mdx-js/react": "^3.1.1",
    "@nice-move/all-in-react": "^0.9.4",
    "@nice-move/syncpack-config": "^0.6.2",
    "@playwright/test": "~1.64.1",
    "@types/node": "^22.18.0",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "@vitest/coverage-istanbul": "^5.0.5",
    "enhanced-resolve": "^5.26.0",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "garou": "^0.9.22",
    "jsdom": "^30.1.3",
    "playwright-bdd": "~9.2.1",
    "prettier": "~3.9.10",
    "syncpack": "^15.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "webpack": "^5.112.0"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^12.14.0"
  },
  "browserslist": {
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 3 safari version"
    ],
    "production": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "prettier": "@nice-move/all-in-react/prettier"
}
