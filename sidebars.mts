import fs from 'node:fs';
import path from 'node:path';

/**
侧边栏按包给：`packages/` 下每个**有 `README.md` 的目录**占一顶层格，
那一格的顶层页就是这个包自己的 README —— Docusaurus 把 `README.md` 认作所在目录的索引页，
所以地址是 `/theme-scalar/`，不是 `/theme-scalar/README`。
它的子页是这个包 `docs/` 目录里的那些页：示例页与维护者文档都住在那儿。

`packages/README.md` 本身不在上面那一次扫描里：它是文件，不是目录（下面那两条 filter 第一条
就把它挡掉），走的是这份清单的头一格 —— 那一份就是主页，`slug: /` 把它落在根，
所以它不占「某个包」那一格。

docId 与 `autogenerated` 的 `dirName` 都相对**内容根**（`packages/`）写：内容根切过去之后，
站点里的文档 id 不再带 `packages/` 那一段。

包清单是扫目录来的，不是手抄的：新增一个包不必回来改这里。`tools/` 那一族假主题不在此列
（它们只用来钉那条层栈，没有面向使用者的文档）。

主页的 `<DocCardList />` 不接 items，取的就是这份根级清单里的兄弟项，所以主页那张卡片列表
自动是一格一张卡 —— 在这里抄第二份清单，就等于又多一处要跟着新增页面改的地方。
*/

// 侧边栏文件由 Docusaurus 的配置加载器读，工作目录就是这个站点根。
const siteDir = process.cwd();

/** 这一层没有类型可借：`@docusaurus/plugin-content-docs` 不是本站点的直接依赖，
它由 preset-classic 带进来。形状写错了不会静默 —— 构建时会认不出这个 docId。 */
function packageCategory(name: string) {
  const docsDir = path.join(siteDir, 'packages', name, 'docs');

  return {
    type: 'category',
    label: name,
    // 卡片上那行说明取自本包 package.json 的 description：包的名字与一句话介绍都写在那儿，
    // 不必再抄第二份。README 本身没有 frontmatter，页面标题取自它的第一个一级标题。
    description: readPackageDescription(name),
    link: { type: 'doc', id: `${name}/README` },
    // 没有 `docs/` 目录的包（眼下只有只有一份 README 的那种）这一格是空的，子页全在 README 正文里。
    items: fs.existsSync(docsDir)
      ? [{ type: 'autogenerated', dirName: `${name}/docs` }]
      : [],
  };
}

function readPackageDescription(name: string): string | undefined {
  const file = path.join(siteDir, 'packages', name, 'package.json');
  if (!fs.existsSync(file)) {
    return undefined;
  }
  const { description } = JSON.parse(fs.readFileSync(file, 'utf8')) as {
    description?: string;
  };
  return description;
}

const packageNames = fs
  .readdirSync(path.join(siteDir, 'packages'))
  .filter((name) =>
    fs.statSync(path.join(siteDir, 'packages', name)).isDirectory(),
  )
  // 有 README.md 才算有一顶层页：包都补齐了这份文档，缺它就正好在这里露出来。
  .filter((name) =>
    fs.existsSync(path.join(siteDir, 'packages', name, 'README.md')),
  );

export default {
  // 第一项是主页：内容根的 `README.md` 以 `slug: /` 落到根，所以它排在这份清单的头一格，
  // 主页那张卡片列表的头一张也是它本身。
  docs: ['README', ...packageNames.map((name) => packageCategory(name))],
};
