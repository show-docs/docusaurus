import fs from 'node:fs';
import path from 'node:path';

/**
侧边栏按包给：`plugins/` 与 `theme/` 下每个有 `README.md` 的目录占一顶层格，
那一格的顶层页就是这个包自己的 README —— Docusaurus 把 `README.md` 认作所在目录的索引页，
所以地址是 `/theme/theme-scalar/`，不是 `/theme/theme-scalar/README`。
它的子页是这个包 `docs/` 目录里的那些页：示例页与维护者文档都住在那儿。

包清单是扫目录来的，不是手抄的：新增一个包不必回来改这里。`demo/` 那一族假主题不在此列
（它们只用来钉那条层栈，没有面向使用者的文档）。

主页的 `<DocCardList />` 不接 items，取的就是这份根级清单里的兄弟项，所以主页那张卡片列表
自动是一格一张卡 —— 在这里抄第二份清单，就等于又多一处要跟着新增页面改的地方。
*/

// 侧边栏文件由 Docusaurus 的配置加载器读，工作目录就是这个站点根。
const siteDir = process.cwd();

/** 这一层没有类型可借：`@docusaurus/plugin-content-docs` 不是本站点的直接依赖，
它由 preset-classic 带进来。形状写错了不会静默 —— 构建时会认不出这个 docId。 */
function packageCategory(dir: string) {
  const docsDir = path.join(siteDir, dir, 'docs');

  return {
    type: 'category',
    label: path.basename(dir),
    // 卡片上那行说明取自本包 package.json 的 description：包的名字与一句话介绍都写在那儿，
    // 不必再抄第二份。README 本身没有 frontmatter，页面标题取自它的第一个一级标题。
    description: readPackageDescription(dir),
    link: { type: 'doc', id: `${dir}/README` },
    // 没有 `docs/` 目录的包（眼下只有只有一份 README 的那种）这一格是空的，子页全在 README 正文里。
    items: fs.existsSync(docsDir)
      ? [{ type: 'autogenerated', dirName: `${dir}/docs` }]
      : [],
  };
}

function readPackageDescription(dir: string): string | undefined {
  const file = path.join(siteDir, dir, 'package.json');
  if (!fs.existsSync(file)) {
    return undefined;
  }
  const { description } = JSON.parse(fs.readFileSync(file, 'utf8')) as {
    description?: string;
  };
  return description;
}

const packageDirs = ['plugins', 'theme']
  .flatMap((group) =>
    fs
      .readdirSync(path.join(siteDir, group))
      .map((name) => `${group}/${name}`)
      .filter((dir) => fs.statSync(path.join(siteDir, dir)).isDirectory()),
  )
  // 有 README.md 才算有一顶层页：包都补齐了这份文档，缺它就正好在这里露出来。
  .filter((dir) => fs.existsSync(path.join(siteDir, dir, 'README.md')));

export default {
  // 第一项是主页：`slug: /` 把它落到根，所以它排在这份清单的头一格，
  // 主页那张卡片列表的头一张也是它本身。
  docs: ['docs/intro', ...packageDirs.map((dir) => packageCategory(dir))],
};
