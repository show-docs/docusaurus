{
  "private": true,
  "name": "@show-docs/docusaurus-theme-redoc",
  "version": "0.0.0",
  "description": "Md 的 frontmatter 写 redoc: <URL> 时把该页整页换成 Redoc 渲染的 API 文档",
  "types": "dist/index.d.mts",
  "main": "dist/index.mjs",
  "exports": {
    ".": {
      "default": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "files": [
    "components",
    "dist",
    "theme"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@redocly/config": "^0.66.0",
    "react-router": "^7.18.4",
    "redoc": "^3.0.1",
    "styled-components": "^6.6.0"
  },
  "peerDependencies": {
    "@docusaurus/types": "^3.10.2",
    "react": "~18.3.1"
  },
  "peerDependenciesMeta": {
    "@docusaurus/types": {
      "optional": true
    }
  },
  "engines": {
    "node": "^24.0.0"
  }
}
