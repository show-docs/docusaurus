{
  "extends": "@nice-move/tsconfig/react.json",
  "//jsx": "`preserve`（写成 `.js` 会在服务端构建里丢依赖）与 `rewriteRelativeImportExtensions`（`react.json` 那条链里没有它）都记在仓库根 README 的「构建包的编译口径」。",
  "compilerOptions": {
    "declaration": true,
    "jsx": "preserve",
    "noEmit": false,
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "types": [
      "node",
      "react",
      "react-dom"
    ]
  },
  "include": [
    "src"
  ],
  "files": [
    "../../types/plugin-prev-layer-resolver.d.ts"
  ]
}
