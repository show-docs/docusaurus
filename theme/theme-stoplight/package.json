{
  "private": true,
  "name": "@show-docs/docusaurus-theme-stoplight",
  "version": "0.0.0",
  "description": "Md 的 frontmatter 写 oas3: <URL> 时把该页正文换成 Stoplight Elements 渲染的 OpenAPI 文档",
  "types": "dist/index.d.mts",
  "main": "dist/index.mjs",
