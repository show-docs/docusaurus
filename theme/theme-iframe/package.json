{
  "private": true,
  "name": "@eaphone/docusaurus-theme-iframe",
  "version": "0.0.0",
  "description": "Md 的 frontmatter 写 iframe: <目标 URL> 时把该页包成内嵌 iframe",
  "types": "dist/index.d.mts",
  "main": "dist/index.mjs",
  "exports": {
    ".": {
      "default": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "files": [
    "dist",
    "styles"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@docusaurus/types": "^3.10.2",
    "react": "~18.3.1"
  },
  "peerDependenciesMeta": {
    "@docusaurus/types": {
      "optional": true
    }
  },
  "engines": {
    "node": "^24.0.0"
  }
}
