{
  "name": "@show-docs/docusaurus-theme-erd",
  "version": "0.2.0",
  "description": "Dbml 文件按关系图渲染，并在正文里附上各格式的导出",
  "keywords": [],
  "homepage": "https://github.com/show-docs/docusaurus/tree/master/packages/theme-erd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/show-docs/docusaurus.git",
    "directory": "packages/theme-erd"
  },
  "bugs": {
    "url": "https://github.com/show-docs/docusaurus/issues"
  },
  "types": "dist/index.d.mts",
  "main": "dist/index.mjs",
