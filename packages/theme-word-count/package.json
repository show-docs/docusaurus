{
  "name": "@show-docs/docusaurus-theme-word-count",
  "version": "0.0.0",
  "description": "构建时统计全站文档的字数，正文里写一行 :::word-count 就在那一处显示所在内容根的数",
  "keywords": [],
  "homepage": "https://github.com/show-docs/docusaurus/tree/master/packages/theme-word-count",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/show-docs/docusaurus.git",
    "directory": "packages/theme-word-count"
  },
  "bugs": {
    "url": "https://github.com/show-docs/docusaurus/issues"
  },
  "types": "dist/index.d.mts",
  "main": "dist/index.mjs",
  "exports": {
    ".": {
      "default": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./types/*": "./types/*"
