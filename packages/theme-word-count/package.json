    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "@docusaurus/plugin-content-docs": "catalog:",
    "@docusaurus/types": "catalog:",
    "@show-docs/docusaurus-plugin-compile-source": "workspace:^",
    "react": "catalog:"
  },
  "peerDependenciesMeta": {
    "@docusaurus/types": {
      "optional": true
    }
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
