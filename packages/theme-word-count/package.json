  "files": [
    "dist",
    "theme",
    "types"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@docusaurus/utils": "catalog:",
    "remark-frontmatter": "^5.0.0",
