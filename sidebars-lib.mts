import fs from 'node:fs';
import path from 'node:path';

/**
侧边栏清单的产地：站点有**两棵文档内容根**（`packages/` 与 `themes/`），两处的判据是同一句话
 —— 「那一棵根下每个**有 `README.md` 的目录**占一顶层格」，所以扫描逻辑写在这一份里，
 由 `sidebars.mts` 与 `sidebars-themes.mts` 各自点名自己的那棵根。抄两份迟早会漂。

那一格的顶层页就是这个包自己的 README —— Docusaurus 把 `README.md` 认作所在目录的索引页，
所以地址是 `/theme-scalar/`（`themes/` 那一族多 `/themes` 一段），不是 `/<根>/theme-scalar/README`。
它的子页是这个包 `docs/` 目录里的那些页：示例页与维护者文档都住在那儿。

docId 与 `autogenerated` 的 `dirName` 都相对**各自的内容根**写，所以两棵根得到的是一份同形的
清单，只是各自那棵根里的包。

包清单是扫目录来的，不是手抄的：新增一个包不必回来改这里。`tools/` 那一族假主题不在此列
（它们只用来钉那条层栈，没有面向使用者的文档）。
*/

/** 这一层没有类型可借：`@docusaurus/plugin-content-docs` 那份形状不在这里点名，
形状写错了不会静默 —— 构建时会认不出这个 docId。 */
function packageCategory(siteDir: string, contentDir: string, name: string) {
  const docsDir = path.join(siteDir, contentDir, name, 'docs');

  return {
    type: 'category',
    label: name,
    // 卡片上那行说明取自本包 package.json 的 description：包的名字与一句话介绍都写在那儿，
    // 不必再抄第二份。README 本身没有 frontmatter，页面标题取自它的第一个一级标题。
    description: readPackageDescription(siteDir, contentDir, name),
    link: { type: 'doc', id: `${name}/README` },
    // 没有 `docs/` 目录的包这一格是空的，子页全在 README 正文里。
    items: fs.existsSync(docsDir)
      ? [{ type: 'autogenerated', dirName: `${name}/docs` }]
      : [],
  };
}

function readPackageDescription(
  siteDir: string,
  contentDir: string,
  name: string,
): string | undefined {
  const file = path.join(siteDir, contentDir, name, 'package.json');
  if (!fs.existsSync(file)) {
    return undefined;
  }
  const { description } = JSON.parse(fs.readFileSync(file, 'utf8')) as {
    description?: string;
  };
  return description;
}

/**
 一棵内容根下所有包的顶层格。`contentDir` 相对站点根（工作目录就是站点根：侧边栏文件由
 Docusaurus 的配置加载器读）。

 有 `README.md` 才算有一顶层页：包都补齐了这份文档，缺它就正好在这里露出来。
 根自己那份 `README.md`（`themes/README.md` 是 `/themes/` 那一页）是文件不是目录，
 被第一条 filter 挡掉，由两份侧边栏文件各自排在清单的头一格。
*/
export function packageCategories(
  contentDir: string,
  siteDir: string = process.cwd(),
) {
  return fs
    .readdirSync(path.join(siteDir, contentDir))
    .filter((name) =>
      fs.statSync(path.join(siteDir, contentDir, name)).isDirectory(),
    )
    .filter((name) =>
      fs.existsSync(path.join(siteDir, contentDir, name, 'README.md')),
    )
    .map((name) => packageCategory(siteDir, contentDir, name));
}
